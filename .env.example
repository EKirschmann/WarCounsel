# Copy to .env and adjust. Every field has a working default.

# --- Your EQL install folder (Logs/ and maps/ are found inside it).
#     The default is the launcher's standard path — adjust if you installed
#     the game somewhere else.
EQL_GAME_DIR=C:\Users\Public\Daybreak Game Company\Installed Games\EverQuest Legends
# EQL_LOG_DIR=             # only if your logs live outside the game folder
# EQL_LOG_PATH=            # full-path override (wins over the dir scan)
# EQL_CHARACTER_NAME=      # prefer this character; else most recent log

# --- LLM for the Advisor/Companion (all optional — the app runs without one;
#     switch at runtime in the Advisor tab's Counsel selector)
LLM_PROVIDER=none          # none | lmstudio | openai | custom | anthropic | local
MODEL=                     # lmstudio/local model id (as LM Studio/Ollama shows it)
OPENAI_API_KEY=
OPENAI_MODEL=o3
# Any OpenAI-compatible endpoint. Grok (xAI) works here — no special
# support needed: CUSTOM_BASE_URL=https://api.x.ai/v1 with a grok-* model.
# Also Groq, OpenRouter, Gemini compat, or a box on your LAN.
# Setting the base URL adds a "Custom" option to the Counsel selector.
CUSTOM_BASE_URL=
CUSTOM_API_KEY=
CUSTOM_MODEL=
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5
# Ollama (LLM_PROVIDER=local): needs `pip install langchain-ollama` and
# `ollama pull <model>`. Point these at another machine if Ollama runs
# on your desktop while you play on a laptop.
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1

# --- EQL MCP server (OPTIONAL: structured spell/AA data; wiki falls back to
#     plain HTTP without it)
# git clone https://github.com/ArtSabintsev/everquest-legends-mcp
# cd everquest-legends-mcp && npm install
MCP_ENABLED=true
MCP_SERVER_DIR=

# --- App
DATABASE_URL=sqlite:///./data/companion.db
FRONTEND_ORIGIN=http://localhost:3000
